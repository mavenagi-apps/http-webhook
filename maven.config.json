{
  "name": "HTTP Webhook",
  "description": "Send HTTP requests to external endpoints. Configure webhooks that fire on LLM actions or Maven events.",
  "version": "1.0.0",
  "author": "Maven AGI",
  "category": "integration",
  "tags": ["webhook", "http", "integration", "api"],
  "install": {
    "title": "Configure HTTP Webhooks",
    "description": "Define webhooks that will be triggered by LLM actions or Maven events",
    "fields": [
      {
        "key": "webhooks",
        "label": "Webhooks",
        "type": "complexarray",
        "required": true,
        "description": "Configure one or more webhooks",
        "fields": [
          {
            "key": "name",
            "label": "Name",
            "type": "text",
            "required": true,
            "description": "Unique identifier for this webhook (used as action/trigger name)",
            "placeholder": "e.g., send_to_slack"
          },
          {
            "key": "description",
            "label": "Description",
            "type": "text",
            "required": true,
            "description": "For LLM actions: tells the AI when to use this. For triggers: documentation.",
            "placeholder": "e.g., Send a notification to Slack when the user requests it"
          },
          {
            "key": "triggerMode",
            "label": "Trigger Mode",
            "type": "dropdown",
            "required": true,
            "description": "How this webhook is triggered",
            "options": [
              { "value": "llm_action", "label": "LLM Action (AI decides when to call)" },
              { "value": "event_trigger", "label": "Event Trigger (automatic on Maven events)" }
            ]
          },
          {
            "key": "eventType",
            "label": "Event Type",
            "type": "dropdown",
            "required": false,
            "description": "For event triggers: which event fires this webhook",
            "options": [
              { "value": "feedback_created", "label": "Feedback Created" },
              { "value": "conversation_created", "label": "Conversation Created" },
              { "value": "event_created", "label": "Event Created" },
              { "value": "inbox_item_created", "label": "Inbox Item Created" }
            ]
          },
          {
            "key": "url",
            "label": "URL",
            "type": "text",
            "required": true,
            "description": "HTTP endpoint URL. Supports {{settings.*}} interpolation.",
            "placeholder": "https://api.example.com/webhook"
          },
          {
            "key": "method",
            "label": "HTTP Method",
            "type": "dropdown",
            "required": true,
            "options": [
              { "value": "GET", "label": "GET" },
              { "value": "POST", "label": "POST" },
              { "value": "PUT", "label": "PUT" },
              { "value": "PATCH", "label": "PATCH" },
              { "value": "DELETE", "label": "DELETE" }
            ]
          },
          {
            "key": "headers",
            "label": "Headers (JSON)",
            "type": "multiline",
            "required": false,
            "description": "HTTP headers as JSON object. Use {{settings.apiKey}} for interpolation.",
            "placeholder": "{\"Authorization\": \"Bearer {{settings.apiKey}}\", \"Content-Type\": \"application/json\"}"
          },
          {
            "key": "bodyTemplate",
            "label": "Body Template",
            "type": "multiline",
            "required": false,
            "description": "Request body with {{variable}} interpolation. Available: {{user.email}}, {{parameters.*}}, {{settings.*}}, {{feedback.*}}, {{conversationId.*}}",
            "placeholder": "{\"message\": \"{{parameters.message}}\", \"user\": \"{{user.email}}\"}"
          },
          {
            "key": "timeout",
            "label": "Timeout (ms)",
            "type": "number",
            "required": false,
            "description": "Request timeout in milliseconds (default: 30000)",
            "default": 30000
          }
        ]
      },
      {
        "key": "apiKey",
        "label": "API Key",
        "type": "password",
        "required": false,
        "description": "Optional API key available as {{settings.apiKey}} in templates"
      },
      {
        "key": "timeout",
        "label": "Default Timeout (ms)",
        "type": "number",
        "required": false,
        "default": 30000,
        "description": "Default request timeout in milliseconds"
      }
    ]
  },
  "permissions": [
    "actions:read",
    "actions:write",
    "triggers:read",
    "triggers:write",
    "conversation:read",
    "users:read"
  ]
}

